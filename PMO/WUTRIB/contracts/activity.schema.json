{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wutrib:pmo:activity-board:v1",
  "title": "WU-TRIB PMO Activity Board v1 — controlled planning record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "project",
    "scope",
    "recordState",
    "boardId",
    "woId",
    "parentWoId",
    "sourceBaselines",
    "policy",
    "activities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wutrib.pmo.activity-board.v1"
    },
    "version": {
      "type": "string"
    },
    "project": {
      "const": "WU-TRIB"
    },
    "scope": {
      "type": "string"
    },
    "recordState": {
      "enum": [
        "PLANNING_NO_GO",
        "IN_REVIEW_NO_GO"
      ]
    },
    "boardId": {
      "type": "string"
    },
    "woId": {
      "const": "WUTRIB-WO-PLAN-019"
    },
    "parentWoId": {
      "const": "WUTRIB-WO-PLAN-018"
    },
    "sourceBaselines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "expectedCount"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "expectedCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "agentCanApprove",
        "agentCanClose",
        "agentCanDeploy",
        "testExecutionAuthorized"
      ],
      "properties": {
        "agentCanApprove": {
          "const": false
        },
        "agentCanClose": {
          "const": false
        },
        "agentCanDeploy": {
          "const": false
        },
        "testExecutionAuthorized": {
          "const": false
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "required": [
        "id",
        "sourceId",
        "type",
        "title",
        "sourcePath",
        "status",
        "ownerRole",
        "priority",
        "phase",
        "requiredEvidence",
        "evidence",
        "manualDecision",
        "sourceFingerprint",
        "drift"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WUTRIB-PMO-(GAP-[0-9]{3}|T[0-9]{2}|GV1-[0-9]{2})$"
        },
        "sourceId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "GAP",
            "TEST",
            "GATE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "status": {
          "enum": [
            "OPEN",
            "IN_PROGRESS",
            "BLOCKED",
            "READY_FOR_REVIEW",
            "NOT_RUN",
            "HOLD_HUMAN"
          ]
        },
        "ownerRole": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "phase": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "requiredEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "observedAt"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "observedAt": {
                "type": "string"
              }
            }
          }
        },
        "manualDecision": {
          "const": null
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceFingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceRemoved": {
          "type": "boolean"
        },
        "drift": {
          "type": "boolean"
        },
        "origin": {
          "type": "string"
        }
      }
    }
  }
}
