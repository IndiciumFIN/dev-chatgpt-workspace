{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wutrib:v1:synthetic-vertical:v1",
  "title": "WU-TRIB V1 synthetic normalized vertical casefile",
  "description": "Planning contract for synthetic inputs. Node engine performs custom validation; schema conformance test has not been claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "nfe",
    "efdText",
    "erp"
  ],
  "properties": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "syntheticOnly",
        "organization",
        "period",
        "codVer",
        "uf",
        "erpRelease",
        "sourceClassification"
      ],
      "properties": {
        "contract": {
          "const": "wutrib.v1.synthetic.vertical.v1"
        },
        "syntheticOnly": {
          "const": true
        },
        "organization": {
          "type": "string",
          "pattern": "^SYNTH-[A-Z0-9-]{3,40}$"
        },
        "period": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "codVer": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "uf": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "erpRelease": {
          "type": "string",
          "pattern": "^SYNTH-[A-Z0-9.]{3,40}$"
        },
        "sourceClassification": {
          "const": "UNREAL_MOCK_DATA_NOT_AUTHORIZED_TAX_DOCUMENTS"
        }
      }
    },
    "nfe": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/nfe"
      }
    },
    "efdText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "erp": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/erp"
      }
    }
  },
  "$defs": {
    "accessKey": {
      "type": "string",
      "pattern": "^[0-9]{44}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,12})\\.[0-9]{2}$"
    },
    "nfe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "organization",
        "period",
        "key",
        "amount",
        "sourceId",
        "status"
      ],
      "properties": {
        "sourceType": {
          "const": "NORMALIZED_SYNTHETIC_NFE"
        },
        "organization": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/accessKey"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^NFE-SYN-[0-9]{3}$"
        },
        "status": {
          "const": "SYNTHETIC_NO_SEFAZ_AUTHORIZATION"
        }
      }
    },
    "erp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "organization",
        "period",
        "release",
        "key",
        "amount",
        "table",
        "field",
        "idtrib"
      ],
      "properties": {
        "sourceType": {
          "const": "PROTHEUS_SYNTHETIC_SNAPSHOT"
        },
        "organization": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "key": {
          "$ref": "#/$defs/accessKey"
        },
        "amount": {
          "$ref": "#/$defs/amount"
        },
        "table": {
          "enum": [
            "SD1",
            "SD2",
            "SFT"
          ]
        },
        "field": {
          "enum": [
            "D1_IDTRIB",
            "D2_IDTRIB",
            "FT_IDTRIB"
          ]
        },
        "idtrib": {
          "type": [
            "string",
            "null"
          ]
        },
        "f2dRuleRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "f2bRuleRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
