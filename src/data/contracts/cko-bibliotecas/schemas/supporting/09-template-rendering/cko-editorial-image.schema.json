{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cko.local/schemas/cko-editorial-image.schema.json",
  "title": "CKO Editorial Manual Image Sidecar Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "asset_type",
    "status",
    "file",
    "editorial",
    "theme",
    "composition",
    "rendering",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^CKO-MANUAL-COVER-[A-Z0-9-]+$"
    },
    "asset_type": {
      "type": "string",
      "const": "editorial_manual_cover"
    },
    "status": {
      "type": "string",
      "enum": [
        "reference",
        "generated",
        "approved",
        "deprecated"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "media_type",
        "file_size_bytes",
        "sha256",
        "width_px",
        "height_px",
        "orientation",
        "aspect_ratio",
        "aspect_ratio_decimal",
        "pixel_palette"
      ],
      "properties": {
        "file_name": {
          "type": "string"
        },
        "media_type": {
          "type": "string",
          "const": "image/png"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "square"
          ]
        },
        "aspect_ratio": {
          "type": "string"
        },
        "aspect_ratio_decimal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pixel_palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "hex",
              "sample_count"
            ],
            "additionalProperties": false,
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9A-F]{6}$"
              },
              "sample_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "manual_type",
        "title",
        "subtitle",
        "language",
        "page_format",
        "purpose"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "manual_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "const": "pt-BR"
        },
        "page_format": {
          "type": "string",
          "const": "A4_portrait"
        },
        "purpose": {
          "type": "string",
          "const": "manual_cover"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "registry_ref"
      ],
      "properties": {
        "theme_id": {
          "type": "string"
        },
        "registry_ref": {
          "type": "string"
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero_scene",
        "primary_subjects",
        "badge_icon",
        "feature_row",
        "footer_band",
        "zones"
      ],
      "properties": {
        "hero_scene": {
          "type": "string"
        },
        "primary_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "badge_icon": {
          "type": "string"
        },
        "feature_row": {
          "type": "boolean"
        },
        "footer_band": {
          "type": "boolean"
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/zone"
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "html_shell",
        "css_theme_attribute",
        "safe_area",
        "print"
      ],
      "properties": {
        "html_shell": {
          "type": "string",
          "const": "cko-editorial-manual-shell-v1"
        },
        "css_theme_attribute": {
          "type": "string"
        },
        "safe_area": {
          "type": "object",
          "required": [
            "top_mm",
            "right_mm",
            "bottom_mm",
            "left_mm"
          ],
          "additionalProperties": false,
          "properties": {
            "top_mm": {
              "type": "number",
              "minimum": 0
            },
            "right_mm": {
              "type": "number",
              "minimum": 0
            },
            "bottom_mm": {
              "type": "number",
              "minimum": 0
            },
            "left_mm": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "print": {
          "type": "object",
          "required": [
            "size",
            "bleed_mm",
            "background_graphics"
          ],
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "const": "A4"
            },
            "bleed_mm": {
              "type": "number",
              "minimum": 0
            },
            "background_graphics": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "source_kind",
        "note",
        "derived_fields"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "user_reference",
            "generated"
          ]
        },
        "note": {
          "type": "string"
        },
        "derived_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "bounds_pct",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "layer": {
          "type": "integer"
        },
        "bounds_pct": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "w": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "h": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    }
  }
}