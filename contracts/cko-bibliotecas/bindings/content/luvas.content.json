      "title": "Técnica de colocação e retirada",
      "priority": 10,
      "payload": {
        "items": [
          {
            "title": "Como colocar",
            "description": "Higiene das mãos; retire uma luva da caixa; calce a primeira e depois a segunda sem tocar em superfícies inadequadas.",
            "icon": "system:clock",
            "action": {
              "label": "Ver sequência",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Como retirar",
            "description": "Pince a parte externa da luva; retire sem contaminar a pele; segure na outra mão; introduza os dedos por dentro e descarte.",
            "icon": "system:clock",
            "action": {
              "label": "Ver sequência",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Ponto crítico",
            "description": "Evitar tocar o rosto, superfícies desnecessárias e ajustar a luva com mãos contaminadas.",
