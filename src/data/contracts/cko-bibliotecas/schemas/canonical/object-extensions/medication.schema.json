{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:object-extension:medication:v1.0.0",
  "title": "CKO Medicamentos Object Extension",
  "description": "Scope contract only. Attribute names are source-derived; values remain epistemic and must be supplied with provenance.",
  "type": "object",
  "required": [
    "extension_version",
    "object_type",
    "attributes"
  ],
  "properties": {
    "extension_version": {
      "const": "1.0.0"
    },
    "object_type": {
      "const": "medication"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "activeIngredient": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "presentation": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "concentration": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "route": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "dilution": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "compatibility": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "highAlert": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "storage": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "regulatoryStatus": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}