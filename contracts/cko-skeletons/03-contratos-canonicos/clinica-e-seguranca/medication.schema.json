{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/medication.schema.json",
  "title": "CKO | medication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "substance_ref",
    "presentation_refs",
    "form_refs",
    "route_refs",
    "regulatory_registration_ref",
    "concentration_refs",
    "license_ref",
    "safety_rule_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "substance_ref": {
      "type": "string",
      "minLength": 1
    },
    "presentation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "form_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regulatory_registration_ref": {
      "type": "string",
      "minLength": 1
    },
    "concentration_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license_ref": {
      "type": "string",
      "minLength": 1
    },
    "safety_rule_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manufacturer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "market_status_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}