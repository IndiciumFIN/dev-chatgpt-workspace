{
  "name": "NK Guard \u2014 NormAtom",
  "description": "Kernel bloqueia artefato sem registro: valida todo NormAtom criado/atualizado contra o metamodelo (POL-NK-001 v1.0.1); inv\u00e1lido \u2192 quarantined",
  "trigger": {
    "condition": "${ .trigger.data.status != \"quarantined\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "NormAtom"
    }
  },
  "definition": {
    "do": [
      {
        "intake_guard": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "entity_name": "NormAtom",
              "record_id": "${ .trigger.entity_id }"
            },
            "function_name": "normKernelIntake"
          },
          "x-base44": {
            "description": "Bloqueia registro sem registro vinculado",
            "title": "Intake guard do \u00e1tomo"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "nk_guard_norm_atom",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}