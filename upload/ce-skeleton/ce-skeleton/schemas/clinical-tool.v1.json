{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-chatgpt-workspace.invalid/schemas/clinical-tool.v1.json",
  "title": "ClinicalTool",
  "status": "CANDIDATE_HOLD",
  "authority": "PROPOSED — piloto da Experience Platform (PR #21). Não é contrato canónico do CKO.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "CALCULATOR",
        "SCALE",
        "PROTOCOL",
        "CHECKLIST",
        "FORM"
      ]
    },
    "toolSourceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorityBinding": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "interpretation": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sourceId"
      ],
      "additionalProperties": false
    },
    "safetyConstraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiresClinicalReview": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE_HOLD",
        "ADMITTED",
        "RETIRED"
      ]
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "kind",
    "status"
  ]
}