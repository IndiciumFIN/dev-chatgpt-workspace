{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/formula.schema.json",
  "title": "CKO | formula",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "expression_ast_ref",
    "input_field_refs",
    "output_quantity_ref",
    "rounding_mode",
    "rounding_stage",
    "calculation_precision",
    "display_precision",
    "test_vector_refs",
    "source_binding_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expression_ast_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_field_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_quantity_ref": {
      "type": "string",
      "minLength": 1
    },
    "rounding_mode": {
      "type": "string",
      "enum": [
        "HALF_EVEN",
        "HALF_UP",
        "TRUNCATE",
        "SOURCE_DEFINED"
      ]
    },
    "rounding_stage": {
      "type": "string",
      "enum": [
        "FINAL",
        "EACH_STEP_SOURCE_DEFINED"
      ]
    },
    "calculation_precision": {
      "type": "integer",
      "minimum": 0
    },
    "display_precision": {
      "type": "integer",
      "minimum": 0
    },
    "test_vector_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_binding_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "override_justification_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
