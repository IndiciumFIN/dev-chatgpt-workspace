{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:object-extension:drain:v1.0.0",
  "title": "CKO Drenos Object Extension",
  "description": "Scope contract only. Attribute names are source-derived; values remain epistemic and must be supplied with provenance.",
  "type": "object",
  "required": [
    "extension_version",
    "object_type",
    "attributes"
  ],
  "properties": {
    "extension_version": {
      "const": "1.0.0"
    },
    "object_type": {
      "const": "drain"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "systemType": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "suction": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "pressure": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "caliber": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "collectionSystem": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "output": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "removalCriteria": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "alerts": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}