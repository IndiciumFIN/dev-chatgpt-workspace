{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/metadata_seo.schema.json",
  "title": "CKO | metadata_seo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "route_registry_ref",
    "object_ref",
    "locale",
    "title_key",
    "description_key",
    "canonical_derived",
    "og_media_ref",
    "structured_data_type_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route_registry_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "description_key": {
      "type": "string",
      "minLength": 1
    },
    "canonical_derived": {
      "type": "boolean",
      "const": true
    },
    "og_media_ref": {
      "type": "string",
      "minLength": 1
    },
    "structured_data_type_ref": {
      "type": "string",
      "minLength": 1
    },
    "hreflang_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_policy_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}