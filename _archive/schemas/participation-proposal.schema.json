{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/schemas/participation-proposal.candidate.v1.json",
  "title": "CE | Participation Proposal Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "process_ref",
    "participant_key",
    "title",
    "problem",
    "proposal",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string"
    },
    "process_ref": {
      "type": "string"
    },
    "participant_key": {
      "type": "string",
      "pattern": "^anon-[a-f0-9-]{36}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 140
    },
    "problem": {
      "type": "string",
      "minLength": 20,
      "maxLength": 900
    },
    "proposal": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "status": {
      "enum": [
        "RECEIVED",
        "REVIEW_REQUIRED",
        "COMMUNITY_PRIORITY",
        "REFERRED_CANDIDATE",
        "CLOSED_CANDIDATE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
