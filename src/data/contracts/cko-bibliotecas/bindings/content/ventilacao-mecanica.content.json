              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Frequência Respiratória (FR)",
            "description": "Número de ciclos por minuto. Adequar à necessidade e conforto do paciente.",
            "icon": "system:clock",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "PEEP",
            "description": "Pressão positiva ao final da expiração. Melhora oxigenação e evita atelectasias.",
            "icon": "system:clock",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "FiO₂",
            "description": "Fração inspirada de oxigênio. Manter a menor concentração efetiva possível.",
            "icon": "system:clock",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Pressão de Pico (Ppico)",
            "description": "Pressão máxima nas vias aéreas. Monitorar para evitar barotrauma.",
            "icon": "system:clock",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          }
        ]
      },
