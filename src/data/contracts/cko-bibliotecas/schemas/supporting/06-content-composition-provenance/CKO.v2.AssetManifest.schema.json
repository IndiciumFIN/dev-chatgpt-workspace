{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:v2:asset-manifest",
  "title": "CKO v2 Asset Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "page_slug",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "page_slug": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}