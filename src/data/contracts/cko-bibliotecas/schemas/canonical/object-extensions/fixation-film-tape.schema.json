    },
    "attributes": {
      "type": "object",
      "properties": {
        "fixationType": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "substrate": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "adhesive": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "skinContact": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "compatibility": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "changeInterval": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "removalMethod": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}