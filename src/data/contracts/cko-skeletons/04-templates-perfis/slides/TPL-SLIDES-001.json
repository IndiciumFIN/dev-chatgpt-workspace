  "block_slots": [
    "CMP-TITLE (slide 1)",
    "CMP-LEAD (subtitle)",
    "CMP-SECTION[] (1 por slide)",
    "CMP-FIGURE[] (1 por slide, fullbleed)",
    "CMP-CHART[] (data slides)",
    "CMP-REFERENCES (slide final)"
  ],
  "required_contracts": [
    "canonical_object",
    "claim",
    "media_asset",
    "visualization",
    "projection",
    "publication"
