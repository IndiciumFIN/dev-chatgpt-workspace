{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirectoryGovernance",
  "type": "object",
  "required": ["id","path","owner","templateId","normativeIds","validators","status","hash","createdAt","updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "path": { "type": "string" },
    "owner": { "type": "string" },
    "templateId": { "type": "string" },
    "normativeIds": { "type": "array", "items": { "type": "string" } },
    "validators": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["draft","admitted","rejected"] },
    "hash": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
