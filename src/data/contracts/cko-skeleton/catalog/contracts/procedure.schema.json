{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/procedure.schema.json",
  "title": "CKO | procedure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "professional_scope_ref",
    "indication_claim_refs",
    "contraindication_claim_refs",
    "step_claim_refs",
    "resource_refs",
    "safety_rules",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "professional_scope_ref": {
      "type": "string",
      "minLength": 1
    },
    "indication_claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contraindication_claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "step_claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safety_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "qualification_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
