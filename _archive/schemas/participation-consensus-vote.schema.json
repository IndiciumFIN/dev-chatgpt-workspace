{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/schemas/participation-consensus-vote.candidate.v1.json",
  "title": "CE | Participation Consensus Vote Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "process_ref",
    "statement_ref",
    "participant_key",
    "position",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string"
    },
    "process_ref": {
      "type": "string"
    },
    "statement_ref": {
      "type": "string"
    },
    "participant_key": {
      "type": "string",
      "pattern": "^anon-[a-f0-9-]{36}$"
    },
    "position": {
      "enum": [
        "AGREE",
        "DISAGREE",
        "UNSURE"
      ]
    },
    "profile": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
