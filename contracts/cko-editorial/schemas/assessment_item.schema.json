{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cko.local/schemas/assessment-item.schema.json",
  "title": "CKO Assessment Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "item_type",
    "prompt_binding",
    "answer_model",
    "evidence_ids"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "single_choice",
        "multiple_choice",
        "true_false",
        "ordering",
        "matching",
        "short_answer",
        "case_decision"
      ]
    },
    "prompt_binding": {
      "type": "object",
      "required": [
        "claim_ids"
      ],
      "properties": {
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "canonical_object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "answer_model": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rationale_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "introductory",
        "basic",
        "intermediate",
        "advanced",
        "expert",
        null
      ]
    },
    "qti_projection": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
