            "action": {
              "label": "Ver mais informações",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "id": "important_characteristics",
            "title": "CARACTERÍSTICAS IMPORTANTES",
            "items": [
              {
                "title": "Material",
                "text": "PVC, silicone, poliuretano ou látex.",
                "icon": "system:document"
              },
              {
                "title": "Calibres",
                "text": "Variam conforme o tipo de sonda e a necessidade clínica.",
                "icon": "system:info"
              },
              {
                "title": "Marcas",
                "text": "Marcas de comprimento auxiliam na correta posição e verificação.",
                "icon": "system:info"
              },
