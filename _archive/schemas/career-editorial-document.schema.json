{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE | Career Editorial Document Candidate",
  "type": "object",
  "required": [
    "id",
    "editorial_id",
    "slug",
    "template_id",
    "locale",
    "audience",
    "title",
    "lead",
    "source_gate",
    "human_gate",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "editorial_id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "audience": {
      "enum": [
        "PROFESSIONAL",
        "YOUTH",
        "BOTH"
      ]
    },
    "title": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "source_gate": {
      "enum": [
        "PASS",
        "HOLD",
        "FAIL"
      ]
    },
    "human_gate": {
      "enum": [
        "PASS",
        "HOLD",
        "FAIL"
      ]
    },
    "status": {
      "enum": [
        "DRAFT_CANDIDATE",
        "HOLD_HUMAN",
        "ASSURED"
      ]
    }
  }
}
