{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE | Career Authority Binding Candidate",
  "type": "object",
  "required": [
    "id",
    "field_path",
    "requirement_id",
    "source_id",
    "authority_class",
    "jurisdiction",
    "applicable_from",
    "decision",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "field_path": {
      "type": "string"
    },
    "requirement_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "authority_class": {
      "enum": [
        "REGULATORY",
        "TECHNICAL_STANDARD",
        "AUTHORITATIVE_TERMINOLOGY",
        "CLINICAL_EVIDENCE",
        "INTERNAL_NONCLINICAL"
      ]
    },
    "jurisdiction": {
      "type": "string"
    },
    "applicable_from": {
      "type": "string",
      "format": "date"
    },
    "applicable_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "HOLD_HUMAN",
        "REJECT",
        "NOT_APPLICABLE_JUSTIFIED"
      ]
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "EVIDENCE_BOUND",
        "HOLD_HUMAN",
        "ASSURED"
      ]
    }
  }
}
