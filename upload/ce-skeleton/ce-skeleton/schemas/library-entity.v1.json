{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-chatgpt-workspace.invalid/schemas/library-entity.v1.json",
  "title": "LibraryEntity",
  "status": "CANDIDATE_HOLD",
  "authority": "PROPOSED — piloto da Experience Platform (PR #21). Não é contrato canónico do CKO.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "canonicalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "ANATOMY",
        "MEDICATION",
        "DEVICE",
        "WOUND",
        "IMAGE",
        "PROTOCOL",
        "FORM",
        "OTHER"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminologyRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "targetId"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE_HOLD",
        "ADMITTED",
        "RETIRED"
      ]
    }
  },
  "required": [
    "id",
    "kind",
    "label",
    "status"
  ]
}