{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/route.schema.json",
  "title": "CKO | route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "object_id",
    "locale",
    "path",
    "canonical_ref",
    "robots_status",
    "route_kind"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "canonical_ref": {
      "type": "string",
      "minLength": 1
    },
    "robots_status": {
      "type": "string",
      "enum": [
        "NOINDEX",
        "INDEX_IF_RELEASED",
        "INDEX"
      ]
    },
    "route_kind": {
      "type": "string",
      "enum": [
        "LIBRARY_HUB",
        "LIBRARY_OBJECT",
        "TOOL",
        "ARTICLE",
        "RESEARCH",
        "OTHER"
      ]
    },
    "hreflang_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "og_asset_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
