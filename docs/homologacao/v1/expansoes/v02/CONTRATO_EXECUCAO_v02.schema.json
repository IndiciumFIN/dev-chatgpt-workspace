{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wutrib:planned:operation-run:v0.2",
  "title": "WU-TRIB Candidate Analytical Operation Run v0.2.0 (documentation only)",
  "description": "Candidate contract to prevent false approvals or loss of run lineage; not a deployed service, test outcome, or fiscal-compliance decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "woId",
    "moduleId",
    "moduleVersion",
    "operationKind",
    "organizationCode",
    "branchCode",
    "sourceDatasetIds",
    "parametersDigest",
    "executionStatus",
    "fiscalConformity",
    "humanApproval",
    "productionAuthorized",
    "startedAt",
    "evidenceRefs",
    "checks",
    "resultDatasets",
    "reason",
    "inputCoverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wutrib.operation-run.v0.2"
    },
    "runId": {
      "type": "string",
      "minLength": 8
    },
    "woId": {
      "type": "string",
      "pattern": "^WUTRIB-WO-[A-Z0-9-]+$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^WUTRIB-EXP-[0-9]{3}$"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "operationKind": {
      "enum": [
        "EXTRACT",
        "PROFILE",
        "NORMALIZE",
        "JOIN",
        "FILTER",
        "SAMPLE",
        "CLASSIFY_EXCEPTION",
        "ANOMALY",
        "TEMPORAL_COMPARE",
        "OTHER"
      ]
    },
    "organizationCode": {
      "type": "string",
      "minLength": 1
    },
    "branchCode": {
      "type": "string",
      "minLength": 1
    },
    "sourceDatasetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parametersDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHashRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "semanticOutputDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "executionStatus": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "PASS",
        "FAIL",
        "BLOCKED",
        "ERROR",
        "PARTIAL",
        "CANCELLED"
      ]
    },
    "fiscalConformity": {
      "const": "NOT_EVALUATED"
    },
    "humanApproval": {
      "const": false
    },
    "productionAuthorized": {
      "const": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "environmentRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultDatasets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibleRows",
        "excludedRows",
        "incompleteSources"
      ],
      "properties": {
        "eligibleRows": {
          "type": "integer",
          "minimum": 0
        },
        "excludedRows": {
          "type": "integer",
          "minimum": 0
        },
        "incompleteSources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "status",
          "ruleRef",
          "reason"
        ],
        "properties": {
          "checkId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "ERROR",
              "NOT_RUN"
            ]
          },
          "ruleRef": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "resourceBudgetRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewerRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "PASS"
          }
        },
        "required": [
          "executionStatus"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "minItems": 1
          },
          "evidenceRefs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionStatus": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "executionStatus"
        ]
      },
      "then": {
        "properties": {
          "resultDatasets": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
