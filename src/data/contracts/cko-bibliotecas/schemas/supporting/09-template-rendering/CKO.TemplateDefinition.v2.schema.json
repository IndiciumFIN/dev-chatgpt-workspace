{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:template-definition:v2.0.0",
  "title": "CKO Unified Template Definition",
  "type": "object",
  "required": [
    "template_id",
    "title",
    "family",
    "archetype",
    "materialization",
    "source",
    "render_strategy",
    "canvas",
    "files",
    "capabilities",
    "renderer_contract",
    "provenance"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "enum": [
        "document",
        "manual",
        "slide",
        "banner",
        "social_post",
        "carousel",
        "story_highlight",
        "web_page",
        "thumbnail",
        "vaccine_editorial",
        "resource",
        "other"
      ]
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "materialization": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "MATERIALIZED",
            "DECLARED_ONLY"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "source_ref",
        "source_kind",
        "authority"
      ],
      "properties": {
        "source_ref": {
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "embedded_html_fragment",
            "embedded_asset",
            "standalone_html",
            "normative_declaration",
            "generated_from_user_reference"
          ]
        },
        "authority": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "render_strategy": {
      "enum": [
        "STANDALONE_HTML",
        "STATIC_ASSET",
        "DYNAMIC_SHELL",
        "DECLARED_ONLY"
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixed_px",
            "a4_portrait",
            "responsive",
            "intrinsic"
          ]
        },
        "width": {
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "px",
            "mm",
            "intrinsic"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape",
            "square",
            "adaptive"
          ]
        },
        "aspect_ratio": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "theme_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "role",
          "required"
        ],
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "data_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "html": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "screen",
          "print",
          "pdf",
          "image",
          "social",
          "web",
          "thumbnail"
        ]
      }
    },
    "output_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "renderer_contract": {
      "type": "object",
      "required": [
        "adapter",
        "safe_html"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "iframe_html",
            "img_asset",
            "editorial_manual_shell",
            "not_materialized"
          ]
        },
        "safe_html": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "related_template_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "class",
        "note"
      ],
      "properties": {
        "class": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "materialization": {
            "properties": {
              "state": {
                "const": "MATERIALIZED"
              }
            }
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "render_strategy": {
              "const": "DECLARED_ONLY"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "render_strategy": {
            "const": "STANDALONE_HTML"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "required": [
              "html"
            ],
            "properties": {
              "html": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "render_strategy": {
            "const": "STATIC_ASSET"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "required": [
              "asset"
            ],
            "properties": {
              "asset": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}