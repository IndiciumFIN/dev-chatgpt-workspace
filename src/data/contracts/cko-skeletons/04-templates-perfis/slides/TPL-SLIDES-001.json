  "block_bindings_schema": {
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "block_id",
        "semantic_role",
        "binding_kind",
        "binding_ids"
      ],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
        },
        "semantic_role": {
          "type": "string",
          "minLength": 1
        },
        "binding_kind": {
          "type": "string",
          "enum": [
            "OBJECT",
            "CLAIM",
            "EVIDENCE",
            "MEDIA",
            "RELATION",
            "COMPUTED_METADATA",
            "I18N_KEY"
          ]
        },
        "binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlay_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visibility_rule_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "gates": {
    "sources": "NOT_APPLICABLE",
    "rights": "NOT_APPLICABLE",
    "a11y": "NOT_APPLICABLE",
    "privacy": "NOT_APPLICABLE",
    "human": "HOLD"
  },
  "renderer_ref": "TODO: preencher renderer_id",
