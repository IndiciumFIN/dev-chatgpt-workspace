{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/performance_budget.schema.json",
  "title": "CKO | performance_budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "metric",
    "target",
    "unit",
    "scenario",
    "measurement_tool_ref",
    "evidence_ref",
    "enforcement"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric": {
      "type": "string",
      "enum": [
        "LCP",
        "INP",
        "CLS",
        "TOTAL_BYTES",
        "JS_BYTES",
        "LOAD_3G",
        "API_LATENCY",
        "IMAGE_BYTES"
      ]
    },
    "target": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "measurement_tool_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "BLOCK",
        "WARN",
        "MONITOR"
      ]
    },
    "device_profile_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
