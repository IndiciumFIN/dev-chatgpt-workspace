          {
            "id": "general_information",
            "title": "INFORMAÇÕES GERAIS",
            "items": [
              {
                "title": "Definição",
                "text": "Sondas são dispositivos de uso temporário inseridos em cavidades ou orifícios do corpo para fins terapêuticos ou diagnósticos.",
                "icon": "system:info"
              },
              {
                "title": "Objetivo do cuidado",
                "text": "Garantir a função indicada da sonda, prevenindo complicações e promovendo o conforto e a segurança do paciente.",
                "icon": "system:info"
              },
              {
                "title": "Importância",
                "text": "Utilização adequada previne complicações como infecções, lesões, obstruções e aspiração.",
                "icon": "system:info"
              },
              {
                "title": "Abrangência",
                "text": "Envolve sondas enterais, vesicais, gastrointestinais e outras sondas.",
