{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/field_definition.schema.json",
  "title": "CKO | field_definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "field_path",
    "semantic_concept_ref",
    "value_type",
    "authority_binding_ref",
    "privacy_policy",
    "applicability_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "field_path": {
      "type": "string",
      "minLength": 1
    },
    "semantic_concept_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "boolean",
        "number",
        "integer",
        "string",
        "code",
        "quantity",
        "date",
        "datetime",
        "reference",
        "array"
      ]
    },
    "authority_binding_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "privacy_policy": {
      "type": "string",
      "enum": [
        "NEVER_PERSIST",
        "SESSION_ONLY",
        "LOCAL_NON_SENSITIVE",
        "LOCAL_WITH_CONSENT"
      ]
    },
    "applicability_ref": {
      "type": "string",
      "minLength": 1
    },
    "unit_ref": {
      "type": "string",
      "minLength": 1
    },
    "validation_rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "message_key": {
      "type": "string",
      "minLength": 1
    },
    "allowed_values_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}