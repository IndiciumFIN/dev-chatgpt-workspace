  "pathophysiology": {
    "mechanism": "Resistência à insulina é o defeito central, levando a hiperinsulinemia compensatória, disfunção endotelial, inflamação crônica, e perfil lipídico aterogênico. O tecido adiposo visceral é metabolicamente ativo e produz citocinas pró-inflamatórias.",
    "affectedSystems": [
      "Endócrino",
      "Cardiovascular",
      "Metabólico"
    ],
    "pathogenicPathways": [
      {
        "pathway": "Resistência à insulina",
        "description": "Reduz captação de glicose e promove hiperinsulinemia",
        "consequence": "Hiperglicemia e dislipidemia"
      },
      {
        "pathway": "Inflamação crônica",
        "description": "Tecido adiposo visceral produz TNF-α, IL-6",
        "consequence": "Disfunção endotelial e aterosclerose"
      },
      {
        "pathway": "Disfunção endotelial",
        "description": "Reduz óxido nítrico",
        "consequence": "Hipertensão e trombose"
      }
    ]
  },
  "diagnosis": {
    "diagnosticCriteria": [
      {
        "criterion": "NCEP ATP III (2005): 3 de 5 critérios",
        "source": "NCEP ATP III / Harmonized",
        "threshold": "≥3 critérios"
      },
      {
        "criterion": "Circunferência abdominal >102cm (H) / >88cm (F)",
        "source": "NCEP ATP III",
        "threshold": ">102/88cm"
      },
      {
        "criterion": "Triglicerídeos ≥150 mg/dL",
        "source": "NCEP ATP III",
        "threshold": "≥150 mg/dL"
      },
      {
        "criterion": "HDL <40 (H) / <50 (F) mg/dL",
        "source": "NCEP ATP III",
        "threshold": "<40/50 mg/dL"
      },
      {
        "criterion": "Pressão arterial ≥130/85 mmHg",
        "source": "NCEP ATP III",
        "threshold": "≥130/85"
      },
      {
        "criterion": "Glicemia de jejum ≥100 mg/dL",
        "source": "NCEP ATP III",
