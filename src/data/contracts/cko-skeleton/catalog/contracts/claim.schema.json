{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/claim.schema.json",
  "title": "CKO | claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "object_id",
    "assertion_key",
    "source_ids",
    "binding_ids",
    "jurisdiction",
    "applicability",
    "review"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "assertion_key": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
      },
      "minItems": 1
    },
    "binding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "required": [
        "population_ref"
      ],
      "properties": {
        "population_ref": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "string",
      "enum": [
        "PENDING",
        "CLINICAL_APPROVED",
        "EDITORIAL_APPROVED",
        "REJECTED"
      ]
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "CLINICAL",
        "ANATOMICAL",
        "EDUCATIONAL",
        "REGULATORY",
        "NONCLINICAL"
      ]
    },
    "confidence_framework_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
