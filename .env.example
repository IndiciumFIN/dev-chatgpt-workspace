# Variáveis de ambiente do projeto.
#
# Copie para `.env.local` (que o .vercelignore impede de subir) e preencha.
# NENHUM valor real vai para este arquivo.

# --- Publicação -------------------------------------------------------------

# "false" esconde a interface de entrada e desliga o gate de identidade.
# Hoje o projeto opera sem login: é o modo de operação atual, não um bug.
# Padrão: se a variável não existir, o login fica LIGADO.
VITE_AUTH_ENABLED=false

# --- Banco de dados --------------------------------------------------------

# O backup v271 mantém o banco desativado incondicionalmente
# (`DB_ENABLED = false` em src/lib/db.ts). `getSql()` lança
# REMOTE_INTEGRATION_BLOCKED e `getPglite()` lança DATABASE_DISABLED_LOCAL_ONLY.
# Preencher isto NÃO reativa o banco: a trava está no código.
DATABASE_URL=

# --- Plataforma (somente se for usar os conectores) -------------------------

GROK_PROJECT_ID=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
GROK_GATE_ORIGIN=