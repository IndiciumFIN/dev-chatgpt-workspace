            "action": {
              "label": "Ver atenção",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Após a retirada",
            "description": "Realizar imediatamente a higiene das mãos.",
            "icon": "system:clock",
            "action": {
              "label": "Ver cuidado",
              "target": "DECISION_REQUIRED"
