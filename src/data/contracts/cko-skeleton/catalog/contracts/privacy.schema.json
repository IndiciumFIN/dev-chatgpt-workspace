{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/privacy.schema.json",
  "title": "CKO | privacy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "privacy_class",
    "sensitive_capture",
    "allowed_persistence",
    "analytics_allowlist",
    "advertising_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "PUBLIC_EDUCATIONAL",
        "NON_SENSITIVE_USER_STATE",
        "EPHEMERAL_CLINICAL_OBSERVATION"
      ]
    },
    "sensitive_capture": {
      "type": "boolean",
      "const": false
    },
    "allowed_persistence": {
      "type": "string",
      "enum": [
        "NEVER_PERSIST",
        "SESSION_ONLY",
        "LOCAL_NON_SENSITIVE",
        "LOCAL_WITH_CONSENT",
        "SERVER_WITH_LEGAL_BASIS",
        "ANONYMIZED_TELEMETRY_ONLY"
      ]
    },
    "analytics_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "advertising_policy": {
      "type": "string",
      "enum": [
        "ADS_ALLOWED",
        "CONTEXTUAL_ONLY",
        "RESTRICTED",
        "BLOCKED"
      ]
    },
    "export_profile_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
