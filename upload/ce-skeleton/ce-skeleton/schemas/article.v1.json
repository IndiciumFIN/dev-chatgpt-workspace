{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-chatgpt-workspace.invalid/schemas/article.v1.json",
  "title": "Article",
  "status": "CANDIDATE_HOLD",
  "authority": "PROPOSED — piloto da Experience Platform (PR #21). Não é contrato canónico do CKO.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "canonicalId": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "body": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE_HOLD",
        "ADMITTED",
        "RETIRED"
      ]
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "title",
    "status"
  ]
}