{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "audit:snapshot": "node scripts/version-register.mjs snapshot manual",
    "audit:verify": "node scripts/version-register.mjs verify",
    "audit:run": "node scripts/version-register.mjs run",
    "audit:clean:check": "node scripts/clean-directory.mjs",
    "audit:context": "node scripts/check-context-invariants.mjs",
    "audit:navigation": "node scripts/audit-navigation-contracts.mjs",
    "predev": "node scripts/version-register.mjs snapshot dev before",
    "postdev": "node scripts/version-register.mjs snapshot dev after",
    "prebuild": "node scripts/version-register.mjs snapshot build before && node scripts/generate-sitemap.mjs",
    "postbuild": "node scripts/version-register.mjs snapshot build after",
    "prebuild:dev": "node scripts/version-register.mjs snapshot build:dev before",
    "postbuild:dev": "node scripts/version-register.mjs snapshot build:dev after",
    "predb:migrate": "node scripts/version-register.mjs snapshot db:migrate before",
    "postdb:migrate": "node scripts/version-register.mjs snapshot db:migrate after",
    "pretest": "node scripts/version-register.mjs snapshot test before",
    "posttest": "node scripts/version-register.mjs snapshot test after",
    "pretypecheck": "node scripts/version-register.mjs snapshot typecheck before",
    "posttypecheck": "node scripts/version-register.mjs snapshot typecheck after",
    "prelint": "node scripts/version-register.mjs snapshot lint before",
    "postlint": "node scripts/version-register.mjs snapshot lint after",
    "preformat": "node scripts/version-register.mjs snapshot format before",
    "postformat": "node scripts/version-register.mjs snapshot format after",
    "precheck:auth": "node scripts/version-register.mjs snapshot check:auth before",
    "postcheck:auth": "node scripts/version-register.mjs snapshot check:auth after",
    "prepreview": "node scripts/version-register.mjs snapshot preview before",
    "postpreview": "node scripts/version-register.mjs snapshot preview after",
    "prepreview:restart": "node scripts/version-register.mjs snapshot preview:restart before",
    "postpreview:restart": "node scripts/version-register.mjs snapshot preview:restart after",
    "prepreview:stop": "node scripts/version-register.mjs snapshot preview:stop before",
    "postpreview:stop": "node scripts/version-register.mjs snapshot preview:stop after",
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/check-contract-coverage.mjs && node scripts/with-app-env.mjs vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node scripts/check-contract-coverage.mjs && node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "audit:isolation": "node scripts/check-isolation.mjs",
    "audit:publication": "node scripts/check-local-publication.mjs && node --experimental-strip-types scripts/test-local-publication.mjs",
    "audit:canonical": "node scripts/audit-canonical-bindings.mjs",
    "audit:canonical:test": "node scripts/test-canonical-contracts.mjs",
    "audit:surfaces:v2": "node scripts/audit-surface-bindings-v2.mjs",
    "audit:surfaces:v2:test": "node scripts/test-surface-bindings-v2.mjs",
    "audit:render:readiness": "node scripts/check-render-readiness.mjs --write-report",
    "audit:runtime:local": "node scripts/check-local-runtime.mjs --write-report",
    "audit:visual:capture": "node scripts/capture-visual-evidence.mjs",
    "audit:i18n": "node scripts/test-locale-registry.mjs",
    "audit:country-icons:evidence": "node scripts/test-country-icon-evidence.mjs",
    "audit:country-icons:accessibility": "node scripts/test-country-icon-a11y.mjs",
    "audit:focus-colors:i18n": "node scripts/test-focus-colors-i18n.mjs",
    "contracts:generate": "node scripts/generate-entity-contracts.mjs",
    "audit:contracts": "node scripts/check-contract-coverage.mjs",
    "audit:country-icons": "node --experimental-strip-types --import ./scripts/alias-hook.mjs scripts/test-country-icons.mjs",
    "content:generate": "node scripts/generate-article-index.mjs && node scripts/generate-entity-contracts.mjs",
    "build:spa": "node scripts/check-generated-fresh.mjs && node scripts/check-cko-packages.mjs && node scripts/test-admin-console.mjs && npm run typecheck && npm test && node scripts/audit-execution-gates.mjs && SPA_BUILD=1 node scripts/with-app-env.mjs vite build && node scripts/materialize-static-routes.mjs",
    "audit:brazil": "node scripts/audit-brazil-first.mjs",
    "audit:templates": "node scripts/audit-templates.mjs",
    "gov:scan": "node scripts/gov-activities.mjs scan",
    "gov:report": "node scripts/gov-activities.mjs report",
    "gov:plan": "node scripts/gov-activities.mjs plan",
    "gov:validate": "node scripts/gov-activities.mjs validate",
    "gov:assist": "node scripts/gov-activities.mjs assist",
    "gov:handoff:check": "node scripts/check-commander-handoffs.mjs",
    "gov:handoff:test": "node --test scripts/test-commander-handoffs.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
