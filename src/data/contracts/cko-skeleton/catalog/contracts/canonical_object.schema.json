{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/canonical_object.schema.json",
  "title": "CKO | canonical_object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "object_type",
    "localized_title_keys",
    "field_binding_ids",
    "relationship_ids",
    "clinical_claim_ids",
    "visibility"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "object_type": {
      "type": "string",
      "enum": [
        "anatomy",
        "medication",
        "device",
        "procedure",
        "protocol",
        "exam",
        "condition",
        "terminology",
        "educational",
        "research_tool",
        "other"
      ]
    },
    "localized_title_keys": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "field_binding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relationship_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clinical_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "PUBLIC_DRAFT",
        "PUBLIC_RELEASED"
      ]
    },
    "classification_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_of_truth": {
      "type": "string",
      "const": "CKO_MD"
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_review": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ]
    }
  }
}
