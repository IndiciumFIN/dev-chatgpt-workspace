{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE | Career Credential Candidate",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "issuer_scope",
    "validity_note",
    "source_required",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "issuer_scope": {
      "type": "string"
    },
    "validity_note": {
      "type": "string"
    },
    "source_required": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "HOLD_HUMAN"
      ]
    }
  }
}
