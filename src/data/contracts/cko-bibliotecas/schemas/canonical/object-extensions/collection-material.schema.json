{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:object-extension:collection-material:v1.0.0",
  "title": "CKO Materiais para Coleta Object Extension",
  "description": "Scope contract only. Attribute names are source-derived; values remain epistemic and must be supplied with provenance.",
  "type": "object",
  "required": [
    "extension_version",
    "object_type",
    "attributes"
  ],
  "properties": {
    "extension_version": {
      "const": "1.0.0"
    },
    "object_type": {
      "const": "collection-material"
    },
    "attributes": {
      "type": "object",
      "properties": {
        "sampleType": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "container": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "additive": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "volume": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "order": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "transport": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "storage": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        },
        "rejectionCriteria": {
          "$ref": "../object/CKO.EpistemicValue.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}