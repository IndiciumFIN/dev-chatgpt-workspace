    "related": {
      "type": "object",
      "description": "Mapeamento automático de relacionamentos para outros objetos do ecossistema CKO",
      "properties": {
        "medications": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CKO-MED-"
          }
        },
        "calculators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CALC-"
          }
        },
        "clinicalScales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCALE-"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diseases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CKO-DIS-"
          }
        },
        "vaccines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CKO-VAC-"
          }
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ANAT-"
          }
