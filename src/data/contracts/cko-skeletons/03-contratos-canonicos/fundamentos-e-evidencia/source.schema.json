{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/source.schema.json",
  "title": "CKO | source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "source_type",
    "title",
    "authority",
    "locator",
    "rights",
    "jurisdiction",
    "retrieved_at",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_type": {
      "type": "string",
      "enum": [
        "OFFICIAL_LAW",
        "REGULATOR",
        "STANDARD",
        "TERMINOLOGY",
        "PRIMARY_STUDY",
        "GUIDELINE",
        "TEXTBOOK",
        "DATASET_API",
        "SOFTWARE",
        "IMAGE",
        "INTERNAL_GOVERNED"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "required": [
        "uri",
        "pinpoint"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "pinpoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "PERMITTED",
        "RESTRICTED",
        "LICENSED",
        "PUBLIC_DOMAIN",
        "NOT_APPLICABLE"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "integrity": {
      "type": "object",
      "required": [
        "sha256",
        "snapshot_ref"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_until": {
      "type": "string",
      "format": "date"
    },
    "license_ref": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    }
  }
}