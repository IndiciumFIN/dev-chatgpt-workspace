{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cko.dev/schemas/CKO-Disease-Schema.json",
  "title": "CKO Disease Schema",
  "description": "Schema do Clinical Knowledge Object (CKO) para a Biblioteca de Doenças. Herda o CKO Base Object e adiciona blocos específicos do domínio de doenças: epidemiology, etiology, pathophysiology, riskFactors, clinicalPresentation, diagnosis, staging, treatment, nursingCare, complications, prognosis, prevention, populations.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "Disease"
    },
    "id": {
      "type": "string",
      "pattern": "^CKO-DIS-[0-9]{6}$",
      "description": "ID único do CKO Disease"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "canonicalName": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acronym": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "slug",
        "description"
      ]
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "icd10": {
          "type": "string",
          "description": "Código ICD-10-CM"
        },
        "icd11": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "uri": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        },
        "snomed": {
          "type": "object",
          "properties": {
            "conceptId": {
              "type": "string"
            },
            "fullySpecifiedName": {
              "type": "string"
            },
            "preferredTerm": {
              "type": "string"
            }
          }
        },
        "medgen": {
          "type": "object"
        },
        "mesh": {
          "type": "object"
        },
        "medlinePlus": {
          "type": "object"
        },
        "loinc": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Códigos LOINC de testes laboratoriais relacionados"
        },
        "diseaseOntology": {
          "type": "string"
        }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "icdChapter": {
          "type": "string"
        },
        "icdCategory": {
          "type": "string"
        },
        "clinicalCategory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "communicability": {
          "type": "string",
          "enum": [
            "communicable",
            "non-communicable",
            "variable"
          ]
        },
        "severity": {
          "type": "string"
        },
        "chronicity": {
          "type": "string"
        }
      }
    },
    "official": {
      "type": "object",
      "description": "Dados oficiais sincronizados via APIs (CDC, WHO, NIH, MedlinePlus, SNOMED, DATASUS, ANVISA)",
      "properties": {
        "cdc": {
          "type": "object"
        },
        "who": {
          "type": "object"
        },
        "nih": {
          "type": "object"
        },
        "medlinePlus": {
          "type": "object"
        },
        "snomed": {
          "type": "object"
        },
        "datasus": {
          "type": "object"
        },
        "anvisa": {
          "type": "object"
        }
      }
    },
    "epidemiology": {
      "type": "object",
      "properties": {
        "globalPrevalence": {
          "type": "object"
        },
        "regionalPrevalence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "incidence": {
          "type": "object"
        },
        "mortality": {
          "type": "object"
        },
        "trends": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "riskFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "determinants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "etiology": {
      "type": "object",
      "properties": {
        "causes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "geneticFactors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "environmentalFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifestyleFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggeringFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pathophysiology": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string"
        },
        "affectedSystems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectedOrgans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cellularLevel": {
          "type": "string"
        },
        "molecularLevel": {
          "type": "string"
        },
        "pathogenicPathways": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "progression": {
          "type": "string"
        }
      }
    },
    "riskFactors": {
      "type": "object",
      "properties": {
        "modifiable": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "nonModifiable": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "composite": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "clinicalPresentation": {
      "type": "object",
      "properties": {
        "signs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "symptoms": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "asymptomaticPhase": {
          "type": "string"
        },
        "typicalPresentation": {
          "type": "string"
        },
        "atypicalPresentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clinicalScales": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "diagnosticCriteria": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "laboratoryTests": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Inclui códigos LOINC"
        },
        "imaging": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "biopsy": {
          "type": "object"
        },
        "scoringSystems": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "staging": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "treatment": {
      "type": "object",
      "properties": {
        "pharmacological": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Referencia ckoMedicationId"
        },
        "nonPharmacological": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "surgical": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Referencia ckoProcedureId"
        },
        "emergency": {
          "type": "object"
        },
        "goals": {
          "type": "object"
        },
        "guidelines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nursingCare": {
      "type": "object",
      "properties": {
        "nanda": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Diagnósticos NANDA-I"
        },
        "nic": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Intervenções NIC"
        },
        "noc": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Resultados NOC"
        },
        "nursingProtocols": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Referencia ckoProtocolId"
        }
      }
    },
    "complications": {
      "type": "object",
      "properties": {
        "acute": {
          "type": "array",
          "items": {
