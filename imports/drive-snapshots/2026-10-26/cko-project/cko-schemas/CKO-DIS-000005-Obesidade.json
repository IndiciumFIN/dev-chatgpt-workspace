  "pathophysiology": {
    "mechanism": "Desequilíbrio energético crônico leva ao acúmulo de tecido adiposo. O tecido adiposo visceral é metabolicamente ativo, produzindo citocinas pró-inflamatórias (TNF-α, IL-6, leptina, adiponectina reduzida). Isto gera resistência à insulina, inflamação crônica e disfunção endotelial.",
    "affectedSystems": [
      "Endócrino",
      "Metabólico",
      "Cardiovascular",
      "Respiratório",
      "Musculoesquelético",
      "Gastrointestinal"
    ],
    "pathogenicPathways": [
      {
        "pathway": "Desequilíbrio energético",
        "description": "Consumo > gasto calórico",
        "consequence": "Acúmulo de tecido adiposo"
      },
      {
        "pathway": "Disfunção do tecido adiposo",
        "description": "Adipócitos hipertrofiados produzem citocinas inflamatórias",
        "consequence": "Resistência à insulina e inflamação crônica"
      },
      {
        "pathway": "Resistência à leptina",
        "description": "Apesar de leptina elevada, sinalização de saciedade comprometida",
        "consequence": "Hiperfagia persistente"
      }
    ]
  },
