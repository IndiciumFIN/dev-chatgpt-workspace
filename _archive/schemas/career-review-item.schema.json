{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CE | Career Review Item Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "item_kind",
    "target_id",
    "review_area",
    "decision",
    "required_role",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "item_kind": {
      "enum": [
        "CLAIM",
        "EDITORIAL_DOCUMENT"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "review_area": {
      "enum": [
        "REGULATORY",
        "EDUCATIONAL",
        "EDITORIAL"
      ]
    },
    "decision": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "HOLD"
      ]
    },
    "required_role": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED"
      ]
    }
  }
}
