{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/ui_interaction.schema.json",
  "title": "CKO | ui_interaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "component_ref",
    "action",
    "enabled_when",
    "disabled_when",
    "aria_message_key",
    "state_transition_ref",
    "failure_recovery"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "component_ref": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "enabled_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disabled_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aria_message_key": {
      "type": "string",
      "minLength": 1
    },
    "state_transition_ref": {
      "type": "string",
      "minLength": 1
    },
    "failure_recovery": {
      "type": "string",
      "minLength": 1
    },
    "persistence_policy_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
