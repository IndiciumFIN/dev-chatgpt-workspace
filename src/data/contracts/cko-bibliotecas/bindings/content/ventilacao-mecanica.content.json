      "module_id": "overview",
      "module_type": "overview",
      "semantic_role": "orientation",
      "title": "Visão Geral",
      "priority": 1,
      "payload": {
        "media": {
          "src": "../assets/ventilacao-mecanica/hero_ventilador.png",
          "alt": "Equipamentos de Ventilação Mecânica",
          "kind": "illustration"
        },
        "groups": [
          {
            "id": "general_information",
            "title": "INFORMAÇÕES GERAIS",
            "items": [
              {
                "title": "Definição",
                "text": "Equipamento que fornece suporte ventilatório invasivo ou não invasivo ao paciente.",
                "icon": "system:clock"
              },
              {
                "title": "Objetivo",
                "text": "Promover trocas gasosas adequadas, reduzir o trabalho respiratório e estabilizar o paciente.",
                "icon": "system:clock"
              },
              {
                "title": "Indicações comuns",
                "text": "Insuficiência respiratória aguda ou crônica, após anestesia, trauma, sepse, DPOC, edema agudo de pulmão, entre outras.",
                "icon": "system:clock"
              },
              {
                "title": "Benefícios",
                "text": "Melhora da oxigenação, redução da fadiga muscular e suporte à recuperação clínica.",
                "icon": "system:clock"
              }
            ],
            "action": {
              "label": "Ver mais informações",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "id": "important_characteristics",
            "title": "CARACTERÍSTICAS IMPORTANTES",
            "items": [
              {
                "title": "Ventilação invasiva e não invasiva",
                "text": "Opções de suporte para diferentes necessidades clínicas.",
                "icon": "system:clock"
              },
              {
                "title": "Modos ventilatórios",
                "text": "Diversos modos para adaptação individual ao quadro do paciente.",
                "icon": "system:clock"
              },
              {
                "title": "Monitorização contínua",
                "text": "Parâmetros respiratórios em tempo real e gráficos de tendência.",
                "icon": "system:clock"
              },
              {
                "title": "Sistemas de segurança",
                "text": "Alarmes, limites e recursos para proteção do paciente.",
                "icon": "system:shield"
              }
            ],
            "action": {
              "label": "Ver guia completo",
              "target": "DECISION_REQUIRED"
            }
          }
        ]
