              }
            ],
            "action": {
              "label": "Ver mais informações",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "id": "important_characteristics",
            "title": "CARACTERÍSTICAS IMPORTANTES",
            "items": [
              {
                "title": "Qualidade da amostra",
                "text": "Amostra adequada e bem identificada assegura resultados confiáveis.",
                "icon": "system:flask"
              },
              {
                "title": "Interferências",
                "text": "Fatores pré-analíticos, analíticos e pós-analíticos podem interferir nos resultados.",
