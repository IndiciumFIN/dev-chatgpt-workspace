            "asset": "../assets/ventilacao-mecanica/tipo_ventilacao_invasiva.png",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Ventilação Não Invasiva",
            "description": "Uso de máscaras facial, nasal ou capacete.",
            "indications": "DPOC, edema agudo de pulmão, hipoxemia.",
            "asset": "../assets/ventilacao-mecanica/tipo_ventilacao_nao_invasiva.png",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Ventilador de Transporte",
            "description": "Leve e compacto para remoções seguras do paciente.",
            "indications": "Transporte intra-hospitalar e inter-hospitalar.",
            "asset": "../assets/ventilacao-mecanica/tipo_ventilador_transporte.png",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Pressão Positiva Contínua (CPAP/BPAP)",
            "description": "Suporte contínuo em vias aéreas para manter a oxigenação.",
            "indications": "Apneia do sono, DPOC, hipoxemia leve.",
            "asset": "../assets/ventilacao-mecanica/tipo_cpap_bpap.png",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          },
          {
            "title": "Interfaces Comuns",
            "description": "Máscara facial, nasal, oronasal, capacete e traqueostomia.",
            "indications": "Ajustar e fixar corretamente para evitar vazamentos.",
            "asset": "../assets/ventilacao-mecanica/tipo_interfaces_comuns.png",
            "action": {
              "label": "Ver detalhes",
              "target": "DECISION_REQUIRED"
            }
          }
        ]
      },
