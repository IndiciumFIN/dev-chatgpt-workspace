{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/terminology.schema.json",
  "title": "CKO | terminology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "code_system",
    "code_system_version",
    "concept_code",
    "canonical_label_key",
    "jurisdiction",
    "rights",
    "mapping_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_system": {
      "type": "string",
      "minLength": 1
    },
    "code_system_version": {
      "type": "string",
      "minLength": 1
    },
    "concept_code": {
      "type": "string",
      "minLength": 1
    },
    "canonical_label_key": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "rights": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "LICENSED",
        "CLEAR",
        "RESTRICTED"
      ]
    },
    "mapping_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition_source_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}