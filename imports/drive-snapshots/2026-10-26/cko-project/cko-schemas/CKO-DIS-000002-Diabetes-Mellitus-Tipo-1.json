  "pathophysiology": {
    "mechanism": "Destruição autoimune das células beta das ilhotas de Langerhans mediada por linfócitos T CD8+, resultando em deficiência absoluta de insulina. Autoanticorpos (anti-GAD, anti-IA2, ZnT8, anti-insulina) são marcadores do processo autoimune.",
    "affectedSystems": [
      "Endócrino (pâncreas)",
      "Metabólico",
      "Cardiovascular",
      "Renal",
      "Neurológico",
      "Oftalmológico"
    ],
    "affectedOrgans": [
      "Pâncreas (ilhotas de Langerhans)",
      "Rins",
      "Retina",
      "Nervos periféricos",
      "Coração"
    ],
    "cellularLevel": "Linfócitos T CD8+ infiltram as ilhotas (insulite) e destroem células beta. Progressão: estágio 1 (autoanticorpos+, normoglicemia) → estágio 2 (autoanticorpos+, disglicemia) → estágio 3 (doença clínica).",
    "molecularLevel": "Ativação de autoanticorpos contra GAD65, IA-2, ZnT8 e insulina. Apoptose de células beta via Fas/FasL, perforina/granzima e citocinas (IFN-γ, TNF-α). Perda de >70-80% da massa de células beta antes do início clínico.",
    "pathogenicPathways": [
      {
        "pathway": "Autoimunidade mediada por células T",
        "description": "Linfócitos T CD8+ reconhecem autoantígenos das células beta e destroem-nas",
        "consequence": "Deficiência absoluta de insulina"
      },
      {
        "pathway": "Produção de autoanticorpos",
        "description": "Linfócitos B produzem anticorpos anti-GAD, anti-IA2, ZnT8",
        "consequence": "Marcadores diagnósticos e prognósticos"
      },
      {
        "pathway": "Insulite",
        "description": "Infiltração inflamatória das ilhotas",
        "consequence": "Destruição progressiva de células beta"
      }
    ],
    "progression": "Estágio 1: Autoanticorpos+ com normoglicemia (risco ~70% em 10 anos) → Estágio 2: Autoanticorpos+ com disglicemia (HbA1c 5.7-6.4%) → Estágio 3: Doença clínica (hiperglicemia sintomática, risco de CAD)"
  },
