          }
        },
        "chronic": {
          "type": [
            "array",
            "object"
          ]
        }
      }
    },
    "prognosis": {
      "type": "object",
      "properties": {
        "lifeExpectancy": {
          "type": "string"
        },
        "qualityOfLife": {
          "type": "string"
        },
        "factors": {
          "type": [
            "array",
            "string"
          ]
        }
      }
    },
    "prevention": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tertiary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "quaternary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "vaccines": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Referencia ckoVaccineId"
        }
      }
    },
    "populations": {
      "type": "object",
      "properties": {
        "pregnancy": {
          "type": "object"
        },
        "lactation": {
          "type": "object"
        },
        "pediatrics": {
          "type": "object"
        },
        "geriatrics": {
