          {
            "id": "general_information",
            "title": "INFORMAÇÕES GERAIS",
            "items": [
              {
                "title": "Definição",
                "text": "Exames laboratoriais são análises realizadas em amostras biológicas para avaliar processos fisiológicos ou patológicos.",
                "icon": "system:flask"
              },
              {
                "title": "Importância",
                "text": "Subsidiar decisões clínicas, diagnóstico, monitorização e avaliação de resposta ao tratamento.",
                "icon": "system:flask"
              },
              {
                "title": "Objetivo do cuidado",
                "text": "Garantir coleta adequada, integridade da amostra e resultados confiáveis para apoiar o cuidado seguro.",
                "icon": "system:flask"
              },
              {
                "title": "Abrangência",
                "text": "Envolve exames de sangue, urina, fezes, líquidos corporais e outros materiais.",
