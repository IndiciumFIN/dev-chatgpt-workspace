{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:vaccine-semantic-supersession:v1.0.0",
  "title": "CKO Vaccine Semantic Supersession Record",
  "type": "object",
  "required": [
    "supersession_id",
    "entity_type",
    "supersedes_ref",
    "replacement_ref",
    "reason",
    "authority",
    "effective_from",
    "source_ref",
    "change_class",
    "reviewed_on"
  ],
  "properties": {
    "supersession_id": {
      "type": "string",
      "pattern": "^cko\\.supersession\\.vaccine\\.[a-z0-9.-]+$"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "claim",
        "program_profile",
        "source_profile",
        "calendar",
        "campaign",
        "object"
      ]
    },
    "supersedes_ref": {
      "type": "string",
      "minLength": 1
    },
    "replacement_ref": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "change_class": {
      "type": "string",
      "enum": [
        "supersession",
        "breaking_change"
      ]
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false
}