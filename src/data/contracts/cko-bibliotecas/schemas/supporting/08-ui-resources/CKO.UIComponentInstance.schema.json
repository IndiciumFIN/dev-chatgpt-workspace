{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cko:ui-component-instance:v1.0.0",
  "title": "CKO UI Component Instance",
  "type": "object",
  "required": [
    "component_id",
    "instance_id",
    "state",
    "placement",
    "data"
  ],
  "properties": {
    "component_id": {
      "type": "string"
    },
    "instance_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "ready",
        "loading",
        "empty",
        "error",
        "disabled",
        "hidden"
      ]
    },
    "placement": {
      "type": "object",
      "required": [
        "zone"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "enum": [
            "action_bar",
            "left_sidebar",
            "main",
            "support_band",
            "sticky_context",
            "resource"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    }
  },
  "additionalProperties": false
}