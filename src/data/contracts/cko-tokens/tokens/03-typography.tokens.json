{
  "display": {
    "hero": {
      "family": "display",
      "size": "5xl",
      "weight": "black",
      "lineHeight": "tight",
      "tracking": "tight"
    },
    "h1": {
      "family": "display",
      "size": "4xl",
      "weight": "black",
      "lineHeight": "tight",
      "tracking": "tight"
    },
    "h2": {
      "family": "display",
      "size": "3xl",
      "weight": "extrabold",
      "lineHeight": "snug"
    },
    "h3": {
      "family": "display",
      "size": "2xl",
      "weight": "extrabold",
      "lineHeight": "snug"
    },
    "h4": {
      "family": "display",
      "size": "xl",
      "weight": "bold",
      "lineHeight": "snug"
    }
  },
  "body": {
    "lg": {
      "family": "body",
      "size": "lg",
      "weight": "regular",
      "lineHeight": "relaxed"
    },
    "md": {
      "family": "body",
      "size": "md",
      "weight": "regular",
      "lineHeight": "relaxed"
    },
    "sm": {
      "family": "body",
      "size": "sm",
      "weight": "regular",
      "lineHeight": "normal"
    },
    "xs": {
      "family": "body",
      "size": "xs",
      "weight": "regular",
      "lineHeight": "normal"
    }
  },
  "label": {
    "md": {
      "family": "body",
      "size": "sm",
      "weight": "bold"
    },
    "sm": {
      "family": "body",
      "size": "xs",
      "weight": "bold",
      "tracking": "wide"
    },
    "eyebrow": {
      "family": "body",
      "size": "xs",
      "weight": "black",
      "tracking": "widest"
    }
  },
  "prose": {
    "measureDefault": {
      "$value": "70ch"
    },
    "measureCompact": {
      "$value": "58ch"
    },
    "measureWide": {
      "$value": "82ch"
    },
    "paragraphGap": {
      "$value": "1rem"
    },
    "sectionGap": {
      "$value": "2.5rem"
    }
  }
}