  "etiology": {
    "causes": [
      {
        "type": "metabolic",
        "description": "Resistência à insulina induzida por hormônios placentários (HPL, progesterona, cortisol, prolactina) combinada com falha da compensação das células beta",
        "weight": "primary"
      },
      {
        "type": "genetic",
        "description": "Predisposição genética similar ao DM2 (TCF7L2, KCNJ11)",
        "weight": "contributing"
      }
    ],
    "environmentalFactors": [
      "Dieta ocidental",
      "Sedentarismo na gestação",
      "Ganho de peso excessivo"
    ],
    "triggeringFactors": [
      "Hormônios placentários anti-insulínicos",
      "Aumento da resistência à insulina no 2º-3º trimestre"
    ]
  },
  "pathophysiology": {
    "mechanism": "Hormônios placentários (HPL, progesterona, cortisol) induzem resistência à insulina progressiva, especialmente no 2º e 3º trimestres. Em mulheres predispostas, as células beta não conseguem compensar, resultando em hiperglicemia.",
    "affectedSystems": [
      "Endócrino",
      "Metabólico",
      "Placentário"
    ],
    "pathogenicPathways": [
      {
        "pathway": "Resistência insulínica placentária",
        "description": "HPL e progesterona reduzem sensibilidade à insulina",
        "consequence": "Hiperglicemia materna"
      },
      {
        "pathway": "Falha de células beta",
        "description": "Compensação insuficiente de insulina",
        "consequence": "Glicemia pós-prandial elevada"
      }
    ]
  },
  "riskFactors": {
