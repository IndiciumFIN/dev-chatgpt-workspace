{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wutrib:planned:dataset-manifest:v0.2",
  "title": "WU-TRIB Candidate Dataset Manifest v0.2.0 (documentation only)",
  "description": "Dataset manifest design candidate only; not deployed or bound to any actual Supabase or ERP implementation. Source contents excluded; no legal or fiscal conformity claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "organizationCode",
    "branchCode",
    "contractId",
    "contractVersion",
    "sourceSystem",
    "sourceType",
    "fiscalPeriod",
    "captureTimestamp",
    "sourceSha256",
    "sourceBytes",
    "recordsRead",
    "recordsAccepted",
    "recordsRejected",
    "datasetState",
    "dataClassification",
    "layoutEdition",
    "fields",
    "lineageParents",
    "fiscalConformity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wutrib.dataset-manifest.v0.2"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "organizationCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "branchCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "contractId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "enum": [
        "XML_NFE",
        "EFD_ICMS_IPI",
        "CSV",
        "TXT",
        "XLSX",
        "ERP_SNAPSHOT",
        "DERIVED_DATASET",
        "OTHER_DEFINED"
      ]
    },
    "erpRelease": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceFieldCatalogRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "layoutEdition": {
      "type": [
        "string",
        "null"
      ]
    },
    "fiscalPeriod": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "captureTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceBytes": {
      "type": "integer",
      "minimum": 0
    },
    "recordsRead": {
      "type": "integer",
      "minimum": 0
    },
    "recordsAccepted": {
      "type": "integer",
      "minimum": 0
    },
    "recordsRejected": {
      "type": "integer",
      "minimum": 0
    },
    "datasetState": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "QUARANTINED",
        "EMPTY_VALID"
      ]
    },
    "dataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "RESTRICTED",
        "SYNTHETIC"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "lineageParents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recordIdPolicy": {
      "type": "string"
    },
    "effectiveFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "fiscalConformity": {
      "const": "NOT_EVALUATED"
    },
    "rejectManifestRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "captureAuthorizationRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "semanticDigest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "datasetState": {
            "const": "EMPTY_VALID"
          }
        },
        "required": [
          "datasetState"
        ]
      },
      "then": {
        "properties": {
          "recordsRead": {
            "const": 0
          },
          "recordsAccepted": {
            "const": 0
          },
          "recordsRejected": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "datasetState": {
            "const": "QUARANTINED"
          }
        },
        "required": [
          "datasetState"
        ]
      },
      "then": {
        "required": [
          "rejectManifestRef"
        ]
      }
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldId",
        "physicalName",
        "logicalType",
        "nullable",
        "sourceColumn",
        "semanticStatus"
      ],
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1
        },
        "physicalName": {
          "type": "string",
          "minLength": 1
        },
        "logicalType": {
          "enum": [
            "STRING",
            "INTEGER",
            "DECIMAL_STRING",
            "DATE",
            "TIMESTAMP",
            "BOOLEAN",
            "CODE",
            "OPAQUE",
            "JSON"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "sourceColumn": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "scale": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "semanticStatus": {
          "enum": [
            "VERIFIED",
            "CANDIDATE",
            "UNKNOWN"
          ]
        },
        "normativeSourceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "transformationRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacyClassification": {
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "RESTRICTED",
            "UNKNOWN"
          ]
        }
      }
    }
  }
}
