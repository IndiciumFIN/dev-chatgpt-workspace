{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calculadorasdeenfermagem.com.br/cko/contracts/v0.1.0/risk_control.schema.json",
  "title": "CKO | risk_control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_id",
    "version",
    "status",
    "updated_at",
    "provenance_refs",
    "risk_id",
    "assertion_ref",
    "control_objective",
    "control_kind",
    "test_procedure_ref",
    "evidence_population_ref",
    "owner_ref",
    "frequency",
    "response_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "DRAFT",
        "SOURCE_QUALIFIED",
        "EVIDENCE_BOUND",
        "REVIEW_REQUIRED",
        "HOLD_HUMAN",
        "ASSURED",
        "ELIGIBLE_FOR_RELEASE",
        "RELEASED",
        "RETIRED"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_id": {
      "type": "string",
      "minLength": 1
    },
    "assertion_ref": {
      "type": "string",
      "minLength": 1
    },
    "control_objective": {
      "type": "string",
      "minLength": 1
    },
    "control_kind": {
      "type": "string",
      "enum": [
        "PREVENTIVE",
        "DETECTIVE",
        "CORRECTIVE"
      ]
    },
    "test_procedure_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_population_ref": {
      "type": "string",
      "minLength": 1
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1
    },
    "frequency": {
      "type": "string",
      "minLength": 1
    },
    "response_policy": {
      "type": "string",
      "enum": [
        "BLOCK",
        "HOLD",
        "REMEDIATE"
      ]
    },
    "framework_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risk_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
